# ==============================================================================
# VITA BABY - VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# DATABASE_URL: String de conexão com Connection Pooling (PgBouncer / Neon pooler)
# DIRECT_URL: String de conexão direta (necessária para rodar prisma migrate)
DATABASE_URL="postgresql://usuario:senha@ep-pooler.sa-east-1.aws.neon.tech/vitababy_db?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-direct.sa-east-1.aws.neon.tech/vitababy_db?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO (Better-Auth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Segredo para assinar cookies e tokens de sessão
# Gere um com: openssl rand -base64 32
BETTER_AUTH_SECRET="sua_chave_secreta_super_segura_32_caracteres"

# BETTER_AUTH_URL: URL base do seu app (em produção: https://vitababy.com.br)
BETTER_AUTH_URL="https://vitababy.com.br"
NEXT_PUBLIC_APP_URL="https://vitababy.com.br"

# ------------------------------------------------------------------------------
# 3. E-MAILS TRANSACIONAIS (Resend API)
# ------------------------------------------------------------------------------
# Chave de API gerada em: https://resend.com/api-keys
EMAIL_API_KEY="re_123456789abcdef"
RESEND_FROM_EMAIL="Vita Baby <contato@vitababy.com.br>"

# ------------------------------------------------------------------------------
# 4. WHATSAPP & INTEGRAÇÕES (Opcional)
# ------------------------------------------------------------------------------
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
