generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?  @db.LongText
  createdAt     DateTime
  updatedAt     DateTime

  // Custom fields
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?
  whatsapp   String?

  sessions            Session[]
  accounts            Account[]
  clientProfile       Client?
  professionalProfile Professional?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Client {
  id           String             @id @default(cuid())
  userId       String?            @unique
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  childName    String?
  email        String?            @unique
  phone        String
  cpf          String?            @unique
  zipCode      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  complement   String?
  address      String? // Keeping legacy address field just in case
  bookings     Booking[]
  contracts    Contract[]
  reviews      Review[]
  notes        ConsultationNote[]
  files        ClientFile[]
  schedules    ClientSchedule[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("client")
}

model Professional {
  id            String             @id @default(cuid())
  userId        String?            @unique
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String?            @unique
  phone         String?
  specialty     String?
  specialties   String?            @db.Text
  crnOrCoren    String?
  experience    String?
  bio           String?            @db.Text
  avatarUrl     String?            @db.LongText
  pixKey        String?
  city          String?
  active        Boolean            @default(true)
  color         String?            @default("#ae4d30")
  scheduleSlots ScheduleSlot[]
  bookings      Booking[]
  notes         ConsultationNote[]
  scheduleShifts ClientScheduleShift[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("professional")
}

model Service {
  id          String           @id @default(cuid())
  name        String
  description String?          @db.Text
  icon        String?
  active      Boolean          @default(true)
  packages    ServicePackage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("service")
}

model ServicePackage {
  id            String    @id @default(cuid())
  serviceId     String
  name          String // Básico, Essencial, Premium
  description   String?   @db.Text
  price         Float?
  duration      Int? // em minutos
  isHighlighted Boolean   @default(false)
  features      String?   @db.Text // JSON array or simple text
  billingCycle  String?   @default("ONETIME") // ONETIME, MONTHLY, QUARTERLY, YEARLY
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@map("service_package")
}

model ScheduleSlot {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date           DateTime // Exact date
  startTime      String // "09:00"
  endTime        String // "10:00"
  isBooked       Boolean      @default(false)
  booking        Booking?

  @@map("schedule_slot")
}

model Booking {
  id       String           @id @default(cuid())
  packages ServicePackage[]

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  scheduleSlotId String       @unique
  scheduleSlot   ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)

  additionalInfo String? @db.Text
  status         String  @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  cancelReason   String? @db.Text
  transportFee   Float?

  contract Contract?
  payments Payment[]
  notes    ConsultationNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking")
}

model Contract {
  id             String  @id @default(cuid())
  
  bookingId      String?  @unique
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  scheduleId     String?
  schedule       ClientSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  content        String  @db.LongText
  signedByClient Boolean @default(false)
  signedByProf   Boolean @default(false)

  // New signature fields
  pdfUrl   String?   @db.LongText
  clientIp String?
  signedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract")
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Float
  description String?  @db.Text
  date        DateTime @default(now())
  status      String   @default("PENDING") // PENDING, PAID, CANCELLED
  method      String? // PIX, CREDIT, DEBIT, MONEY
  type        String   @default("INCOME") // INCOME, EXPENSE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment")
}

model Review {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId     String?
  rating        Int
  comment       String   @db.Text
  isHighlighted Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("review")
}

model ContractTemplate {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contract_template")
}

model ConsultationNote {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  date        DateTime @default(now())
  title       String
  content     String   @db.LongText
  sombraNotes String?  @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consultation_note")
}

model PlannerItem {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  type        String // EVENT, REMINDER, NOTE
  date        DateTime // For the day it occurs
  startTime   String? // "09:00" - nullable for all-day notes
  endTime     String? // "10:00" - nullable
  color       String?
  notifyAt    DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("planner_item")
}

model ClientFile {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  fileUrl     String   @db.LongText
  fileType    String
  uploadedBy  String // "CLIENT" or "PROFESSIONAL"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_file")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String?
  message   String   @db.Text
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_message")
}

model ClientSchedule {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     String   // Format: "YYYY-MM"
  title     String?  // e.g., "Escala Mensal - Setembro"
  shifts    ClientScheduleShift[]
  contracts Contract[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_schedule")
}

model ClientScheduleShift {
  id               String         @id @default(cuid())
  scheduleId       String
  schedule         ClientSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date             DateTime
  startTime        String
  endTime          String
  professionalId   String
  professional     Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  status           String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("client_schedule_shift")
}

model PublicGallery {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String   @db.LongText
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("public_gallery")
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String   @db.LongText
  link      String?  @db.Text
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner")
}
